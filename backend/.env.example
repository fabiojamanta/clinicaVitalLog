# Banco local (padrao)
DATABASE_URL=sqlite:///./clinica_estoque.db
ENV=development
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
APP_NAME=Sanelis Medical EcoSystem

# Admin inicial (dev: se vazio, usa admin@localhost e gera senha no primeiro boot)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PIN opcional para assinatura publica remota
PUBLIC_SIGN_PIN=

# Para apontar para o banco publicado no Render, NAO altere este arquivo:
# preencha backend/.env.render com a External Database URL e inicie com
#   start-backend.bat render
